# ============================================================
# MedBook Environment Variables (mẫu)
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env thật lên Git
# ============================================================

# ===== Database =====
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=medbook_db
DB_PORT=3307

# ===== Application =====
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ===== JWT (sẽ dùng sau) =====
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=900000
JWT_REFRESH_EXPIRES_IN=604800000

# ===== phpMyAdmin =====
PMA_PORT=8081