# ============================================================
# MedBook - biến môi trường cho docker compose (mẫu)
#
#   Copy-Item .env.example .env        (Windows PowerShell)
#   cp .env.example .env               (Linux, macOS)
#
# rồi sửa các giá trị bên dưới. KHÔNG đưa tệp .env lên Git.
# ============================================================

# ===== Cơ sở dữ liệu (bắt buộc) =====
# Mật khẩu root của MySQL trong container. Chỉ có tác dụng khi volume db_data được tạo LẦN ĐẦU:
# nếu đã có volume dựng từ bản cũ (mật khẩu là "root") thì phải giữ đúng mật khẩu cũ đó.
MYSQL_ROOT_PASSWORD=doi-mat-khau-nay
MYSQL_DATABASE=medbook_db

# ===== JWT (bắt buộc) =====
# Khóa ký token: chuỗi ngẫu nhiên từ 32 ký tự. Ứng dụng từ chối khởi động nếu để nguyên giá trị mẫu này.
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   Linux:      openssl rand -base64 48
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Thời hạn access token, mili giây (mặc định 15 phút)
JWT_EXPIRATION=900000

# ===== Ứng dụng =====
# Cổng trên máy chủ. Đổi APP_PORT nếu 8080 đang bị chương trình khác dùng.
APP_PORT=8080
DB_PORT=3307
PMA_PORT=8081
# Nguồn (origin) được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy
MEDBOOK_CORS_ALLOWED_ORIGINS=http://localhost:8080

# true: nạp tài khoản demo (admin1, doctor1, doctor2, patient1, patient2 - mật khẩu MedBook@2026) và dữ liệu mẫu
# một lần khi CSDL còn trống. Để false trên môi trường thật.
MEDBOOK_SEED_DEMO=true

# true: mở tài liệu API tại /swagger-ui.html và /v3/api-docs. Để false trên môi trường thật.
MEDBOOK_OPENAPI_ENABLED=false
