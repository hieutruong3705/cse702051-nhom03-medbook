<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MedBook - Báo cáo & Thống kê</title>
  <!-- Google Fonts, Font Awesome & Chart.js -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background-color: #f4f7fe; color: #2b3674; padding: 20px; }
    
    /* Header Bar */
    .header-card {
      background: linear-gradient(135deg, #0062ff 0%, #00a2ff 100%);
      color: #ffffff;
      padding: 24px;
      border-radius: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0px 10px 20px rgba(0, 98, 255, 0.15);
      margin-bottom: 20px;
    }
    .header-title h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
    .header-title p { font-size: 13px; opacity: 0.85; margin-top: 4px; }
    
    .user-badge {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      padding: 10px 18px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .user-avatar {
      width: 40px; height: 40px; border-radius: 50%;
      background: #ffffff; color: #0062ff;
      display: flex; align-items: center; justify-content: center;
      font-weight: bold; font-size: 16px;
    }
    .user-info .name { font-weight: 600; font-size: 14px; }
    .user-info .code { font-size: 12px; opacity: 0.8; }
    .btn-logout {
      background: rgba(255, 255, 255, 0.2); border: none; color: white;
      padding: 8px 12px; border-radius: 8px; cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-logout:hover { background: rgba(239, 68, 68, 0.9); }

    /* Info Strip */
    .info-banner {
      background: #ffffff; padding: 16px 20px; border-radius: 12px;
      box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.03); margin-bottom: 24px;
      display: flex; align-items: center; gap: 10px; font-size: 14px; color: #475569;
    }
    .info-banner i { color: #0062ff; font-size: 16px; }

    /* Main Section */
    .main-card {
      background: #ffffff; padding: 28px; border-radius: 16px;
      box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.05);
    }
    .section-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
    }
    .section-title { font-size: 18px; font-weight: 700; color: #1b2559; }
    
    .action-buttons { display: flex; gap: 12px; }
    .btn {
      padding: 10px 18px; border-radius: 10px; font-weight: 600; font-size: 13px;
      border: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-excel { background-color: #10b981; color: white; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2); }
    .btn-all { background-color: #0062ff; color: white; box-shadow: 0 4px 10px rgba(0, 98, 255, 0.2); }

    /* Chart Box */
    .chart-wrapper {
      position: relative; height: 320px; width: 100%; margin-top: 10px;
    }
  </style>
</head>
<body>

  <!-- 1. Header & Thông tin người dùng đăng nhập -->
  <header class="header-card">
    <div class="header-title">
      <h1>MEDBOOK - BÁO CÁO & THỐNG KÊ (V5)</h1>
      <p>Hệ thống quản lý trực tuyến: medbook-v4.35.213.191.233.sslip.io</p>
    </div>
    
    <div class="user-badge">
      <div class="user-avatar" id="userAvatar">--</div>
      <div class="user-info">
        <div class="name" id="displayUserName">Đang tải...</div>
        <div class="code" id="displayUserCode">Mã: --</div>
      </div>
      <button onclick="handleLogout()" class="btn-logout" title="Đăng xuất">
        <i class="fa-solid fa-right-from-bracket"></i>
      </button>
    </div>
  </header>

  <!-- 2. Thanh thông tin tóm tắt lịch hẹn -->
  <div class="info-banner">
    <i class="fa-solid fa-circle-info"></i>
    <span>Lịch hẹn gần nhất: <strong id="subNextAppointment" style="color: #1b2559;">Đang cập nhật...</strong></span>
  </div>

  <!-- 3. Khu vực Thống kê & Biểu đồ -->
  <main class="main-card">
    <div class="section-header">
      <h2 class="section-title">1. Báo cáo Thống kê Lượt khám & Lịch hẹn</h2>
      <div class="action-buttons">
        <button onclick="downloadPersonalReport()" class="btn btn-excel">
          <i class="fa-solid fa-file-excel"></i> Tải lịch khám cá nhân (.xlsx)
        </button>
        <button id="btnExportAll" onclick="downloadAllReport()" class="btn btn-all" style="display: none;">
          <i class="fa-solid fa-download"></i> Xuất báo cáo TOÀN BỘ bệnh nhân
        </button>
      </div>
    </div>

    <div class="chart-wrapper">
      <canvas id="visitsChart"></canvas>
    </div>
  </main>

  <!-- 4. JavaScript xử lý dữ liệu đăng nhập động -->
  <script>
    let visitsChart = null;

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Kiểm tra session từ localStorage
      const rawUserData = localStorage.getItem('user_info');

      // Nếu chưa đăng nhập -> Chuyển về login
      if (!rawUserData) {
        alert('Vui lòng đăng nhập trước khi truy cập báo cáo!');
        window.location.href = '/login.html';
        return;
      }

      const currentUser = JSON.parse(rawUserData);

      // 2. Hiển thị thông tin tên & mã của User đăng nhập
      document.getElementById('displayUserName').textContent = currentUser.fullName || 'Người dùng';
      document.getElementById('displayUserCode').textContent = `Mã: ${currentUser.userCode || 'N/A'}`;
      
      // Tạo avatar tròn từ chữ cái đầu tiên của tên
      const initials = currentUser.fullName 
        ? currentUser.fullName.split(' ').map(n => n[0]).slice(-2).join('').toUpperCase()
        : 'US';
      document.getElementById('userAvatar').textContent = initials;

      // 3. Phân quyền nút bấm nếu là Bác sĩ/Admin
      if (currentUser.role === 'ADMIN' || currentUser.role === 'DOCTOR') {
        document.getElementById('btnExportAll').style.display = 'flex';
      }

      // 4. Lấy dữ liệu báo cáo riêng cho User này
      loadDashboardData(currentUser);
    });

    // Gọi API lấy dữ liệu thực tế
    async function loadDashboardData(user) {
      try {
        const response = await fetch(`https://medbook-v4.35.213.191.233.sslip.io/api/v1/patients/${user.userId}/dashboard`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${user.token}`,
            'Content-Type': 'application/json'
          }
        });

        if (!response.ok) {
          renderFallbackChart();
          document.getElementById('subNextAppointment').textContent = '20/10/2026 với Bác sĩ Huy (Nhi khoa)';
          return;
        }

        const data = await response.json();

        if (data.nextAppointment) {
          document.getElementById('subNextAppointment').textContent = 
            `${data.nextAppointment.date} với ${data.nextAppointment.doctorName}`;
        } else {
          document.getElementById('subNextAppointment').textContent = 'Chưa có lịch hẹn mới';
        }

        renderChart(data.monthlyVisits.labels, data.monthlyVisits.data);

      } catch (error) {
        console.warn('Dùng dữ liệu mẫu do không kết nối được Backend:', error);
        renderFallbackChart();
      }
    }

    // Vẽ biểu đồ cột bằng Chart.js
    function renderChart(labels, dataValues) {
      const ctx = document.getElementById('visitsChart').getContext('2d');
      
      if (visitsChart) visitsChart.destroy();

      visitsChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Số lượt khám',
            data: dataValues,
            backgroundColor: '#0062ff',
            borderRadius: 6,
            barThickness: 45
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    function renderFallbackChart() {
      renderChart(['Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10'], [1, 2, 4, 2]);
      document.getElementById('subNextAppointment').textContent = '20/10/2026 với Bác sĩ Huy (Nhi khoa)';
    }

    // Tải file Excel tương ứng với Patient ID
    function downloadPersonalReport() {
      const user = JSON.parse(localStorage.getItem('user_info'));
      if (!user) return;
      
      const downloadUrl = `https://medbook-v4.35.213.191.233.sslip.io/api/v1/reports/export-patient?patientId=${user.userId}`;
      window.open(downloadUrl, '_blank');
    }

    // Đăng xuất
    function handleLogout() {
      if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
        localStorage.removeItem('user_info');
        window.location.href = '/login.html';
      }
    }
  </script>
</body>
</html>
